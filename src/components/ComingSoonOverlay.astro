---
const contactHref = "mailto:meezaandavids365@gmail.com";
---

<section class="coming-soon-overlay" aria-labelledby="coming-soon-heading">
  <div class="coming-soon-card">
    <p class="coming-soon-kicker">Web dev.</p>
    <h1 id="coming-soon-heading">Coming soon.</h1>
    <p>
      This website is getting polished up before launch. Check back shortly, or
      email Meezaan if you need help with a website now.
    </p>
    <a href={contactHref}>Get in touch</a>
  </div>
</section>

<style>
  .coming-soon-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    min-height: 100svh;
    padding: 1.5rem;
    background:
      radial-gradient(circle at top left, rgba(255, 255, 255, 0.18), transparent 32rem),
      linear-gradient(135deg, rgba(17, 19, 28, 0.96), rgba(26, 26, 26, 0.92));
    color: #ffffff;
    backdrop-filter: blur(14px);
  }

  .coming-soon-card {
    width: min(100%, 42rem);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 2rem;
    padding: clamp(2rem, 6vw, 4rem);
    background: rgba(255, 255, 255, 0.08);
    box-shadow: 0 2rem 6rem rgba(0, 0, 0, 0.35);
    text-align: center;
  }

  .coming-soon-kicker {
    margin: 0 0 1rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.62);
  }

  h1 {
    margin: 0;
    font-size: clamp(4rem, 13vw, 8rem);
    line-height: 0.9;
    color: #ffffff;
  }

  .coming-soon-card p:not(.coming-soon-kicker) {
    max-width: 34rem;
    margin: 1.5rem auto 0;
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.72);
  }

  a {
    display: inline-flex;
    margin-top: 2rem;
    border-radius: 999px;
    background: #ffffff;
    padding: 1rem 1.4rem;
    font-weight: 700;
    color: #11131c;
    text-decoration: none;
    transition: transform 200ms ease, background-color 200ms ease;
  }

  a:hover {
    transform: translateY(-2px);
    background: rgba(255, 255, 255, 0.9);
  }
</style>

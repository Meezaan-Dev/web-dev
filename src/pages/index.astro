---
import Layout from "../layouts/Layout.astro";
import { websites } from "../data/websites";
---

<Layout title="Web Dev. | Selected Work">
  <section
    class="container-site pb-16 pt-40 md:pb-24 md:pt-48"
    aria-labelledby="work-heading"
  >
    <div
      class="grid gap-8 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] md:gap-16"
    >
      <p
        class="text-xs font-medium uppercase tracking-[0.2em] text-foreground/50"
      >
        Selected work
      </p>
      <div>
        <h1
          id="work-heading"
          class="max-w-3xl text-5xl leading-[0.98] text-foreground md:text-7xl"
        >
          Websites built with purpose.
        </h1>
        <p
          class="mt-8 max-w-2xl text-base leading-7 text-foreground/60 md:text-lg md:leading-8"
        >
          A selection of digital experiences created to give each business a
          clear, confident home online.
        </p>
      </div>
    </div>
  </section>

  <section
    class="container-site pb-24 md:pb-32"
    aria-label="Website projects"
  >
    <div class="space-y-20 md:space-y-32">
      {
        websites.map((website, index) => (
          <article>
            <a
              href={website.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group block overflow-hidden bg-foreground/5"
              aria-label={`Visit ${website.title} website`}
            >
              <div
                class="overflow-hidden bg-foreground/[0.03] px-2 py-5 md:px-8 md:py-10"
              >
                <img
                  src={website.preview}
                  alt={`${website.title} homepage preview`}
                  class="mx-auto h-auto w-full transition-transform duration-700 ease-out group-hover:scale-[1.015]"
                  loading={index === 0 ? "eager" : "lazy"}
                />
              </div>
            </a>

            <div
              class="grid gap-6 border-b border-foreground/20 py-7 md:grid-cols-2 md:gap-16 md:py-9"
            >
              <div class="flex items-start justify-between gap-6">
                <div>
                  <p
                    class="mb-3 text-xs font-medium uppercase tracking-[0.18em] text-foreground/50"
                  >
                    {String(index + 1).padStart(2, "0")} / {website.category}
                  </p>
                  <h2 class="text-3xl text-foreground md:text-4xl">
                    {website.title}
                  </h2>
                </div>
                <span
                  class="shrink-0 text-sm tabular-nums text-foreground/50"
                >
                  {website.year}
                </span>
              </div>

              <div>
                <p
                  class="max-w-xl text-sm leading-7 text-foreground/60 md:text-base"
                >
                  {website.description}
                </p>
                <a
                  href={website.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group mt-6 inline-flex items-center gap-2 text-xs font-medium uppercase tracking-[0.16em]"
                >
                  <span>Visit website</span>
                  <svg
                    class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-1"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="1.5"
                      d="M7 17 17 7M7 7h10v10"
                    />
                  </svg>
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</Layout>

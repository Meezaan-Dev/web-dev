---
import Layout from "../layouts/Layout.astro";
import { websites } from "../data/websites";

const whatsappHref =
  "https://wa.me/27658707217?text=Hi%20Meezaan%2C%20I'm%20interested%20in%20getting%20some%20help%20with%20my%20website.";
const aboutImageUrl =
  "https://res.cloudinary.com/duuyolqrm/image/upload/v1787953690/IMG_6963_mm3wbo.jpg";

const services = [
  {
    number: "01",
    title: "Don't have a website?",
    answer: "I'll build one that gives your business a proper home online.",
  },
  {
    number: "02",
    title: "Already have one?",
    answer: "I can make it cleaner, faster and easier for customers to use.",
  },
  {
    number: "03",
    title: "Something broken?",
    answer: "Send me the link and I'll take a look.",
  },
  {
    number: "04",
    title: "Need changes later?",
    answer: "Message me when your website needs updates or tweaks.",
  },
];

const prices = [
  { service: "Website fixes", price: "from R350" },
  { service: "Landing pages", price: "from R1,500" },
  { service: "Small business websites", price: "from R2,000" },
  { service: "Ongoing support", price: "from R350/month" },
];
---

<Layout
  title="Web Dev. | Websites sorted for local businesses"
  description="Straightforward websites for Cape Town small businesses, built personally by Meezaan Davids."
>
  <section
    class="container-site animate-section overflow-hidden pb-20 pt-32 md:pb-28 md:pt-44"
    aria-labelledby="hero-heading"
  >
    <div class="grid items-center gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
      <div>
        <h1
          id="hero-heading"
          class="max-w-3xl text-5xl leading-[0.95] text-foreground md:text-7xl"
        >
          Yeah, you probably need a website.
        </h1>
        <p
          class="mt-8 max-w-2xl text-base leading-7 text-foreground/65 md:text-xl md:leading-9"
        >
          Your customers Google everything. Your business should probably be
          there too.
        </p>
        <p
          class="mt-5 max-w-2xl text-sm leading-7 text-foreground/60 md:text-base"
        >
          I'm Meezaan, a Cape Town software developer who builds straightforward
          websites for local businesses.
        </p>
        <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center">
          <a
            href={whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            class="hover-lift inline-flex w-full justify-center rounded-full bg-foreground px-6 py-4 font-display text-sm font-semibold text-background transition-colors hover:bg-foreground/90 sm:w-auto"
          >
            Let's get yours sorted
          </a>
          <a
            href="#work"
            class="hover-lift inline-flex w-full justify-center rounded-full border border-foreground/20 px-6 py-4 font-display text-sm font-semibold text-foreground transition-colors hover:border-foreground/40 sm:w-auto"
          >
            See the work
          </a>
        </div>
      </div>

      <div
        aria-hidden="true"
        class="relative flex min-h-[360px] items-center justify-center overflow-hidden md:min-h-[520px]"
      >
        <img
          src="/undraw_enter-payment-info_k1yw.svg"
          alt=""
          class="hero-shot hero-shot-primary h-auto w-full max-w-[620px]"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <section
    id="services"
    class="container-site animate-section scroll-mt-28 py-20 md:py-28"
    aria-labelledby="services-heading"
  >
    <div>
      <h2
        id="services-heading"
        class="max-w-4xl text-5xl leading-tight text-foreground md:text-7xl"
      >
        Here's what I actually do.
      </h2>
      <div class="mt-12 border-y border-foreground/15">
        {
          services.map((service) => (
            <article class="group grid gap-4 border-b border-foreground/10 py-8 last:border-b-0 md:grid-cols-[0.35fr_1.1fr_1fr] md:items-baseline md:gap-10 md:py-10">
              <p class="text-sm font-medium tabular-nums text-foreground/40 transition-colors group-hover:text-foreground">
                {service.number}
              </p>
              <h3 class="text-3xl leading-tight text-foreground md:text-4xl">
                {service.title}
              </h3>
              <p class="max-w-xl text-base leading-7 text-foreground/60 md:text-lg md:leading-8">
                {service.answer}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section
    id="work"
    class="container-site animate-section scroll-mt-28 py-20 md:py-28"
    aria-labelledby="work-heading"
  >
    <div class="mx-auto mb-14 max-w-3xl text-center">
      <p
        class="text-xs font-medium uppercase tracking-[0.2em] text-foreground/50"
      >
        Selected work
      </p>
      <h2
        id="work-heading"
        class="mt-4 text-5xl leading-tight text-foreground md:text-6xl"
      >
        Some stuff I've built.
      </h2>
      <p class="mx-auto mt-6 max-w-2xl text-sm leading-7 text-foreground/60 md:text-base">
        Swipe through the work, then open a project if you want a bit more context.
      </p>
    </div>

    <div class="space-y-20 md:space-y-28" aria-label="Project showcase">
      {
        websites.map((website, index) => (
          <a
            href={`/work/${website.slug}`}
            class="group block"
            aria-label={`View ${website.title} project page`}
          >
            <article>
              <img
                src={website.preview}
                alt={`${website.title} homepage preview`}
                class="h-auto w-full transition-transform duration-700 ease-out group-hover:scale-[1.01]"
                loading={index === 0 ? "eager" : "lazy"}
              />
              <div class="mt-6 grid gap-4 border-b border-foreground/15 pb-8 md:grid-cols-[1fr_auto] md:items-end">
                <div>
                  <p class="text-xs font-medium uppercase tracking-[0.18em] text-foreground/45">
                    {website.category} · {website.year}
                  </p>
                  <h3 class="mt-3 text-4xl leading-tight text-foreground md:text-5xl">
                    {website.title}
                  </h3>
                </div>
                <span class="inline-flex text-xs font-medium uppercase tracking-[0.16em] text-foreground">
                  View project
                </span>
              </div>
            </article>
          </a>
        ))
      }
    </div>
  </section>

  <section
    id="about"
    class="container-site animate-section scroll-mt-28 py-20 md:py-28"
    aria-labelledby="about-heading"
  >
    <div
      class="overflow-hidden rounded-[28px] bg-foreground px-6 py-14 text-background md:px-12 md:py-20"
    >
      <div class="grid gap-10 md:grid-cols-[0.85fr_1.15fr] md:items-center md:gap-16">
        <div class="mx-auto aspect-square w-full max-w-[280px] overflow-hidden rounded-full border border-background/20 md:max-w-[360px]">
          <img
            src={aboutImageUrl}
            alt="Meezaan Davids"
            class="h-full w-full object-cover object-center"
            loading="lazy"
          />
        </div>

        <div>
          <p class="text-xs font-medium uppercase tracking-[0.2em] text-background/50">
            About
          </p>
          <h2
            id="about-heading"
            class="mt-5 max-w-3xl text-5xl leading-tight md:text-6xl"
          >
            Hi, I'm Meezaan.
          </h2>
          <div
            class="mt-8 max-w-2xl space-y-5 text-sm leading-7 text-background/70 md:text-base"
          >
            <p>I'm a software developer based in Cape Town.</p>
            <p>
              I build software professionally, and outside of work I help local
              businesses get their websites sorted.
            </p>
            <p class="font-medium text-background">
              No agency. No salesperson. You deal directly with me.
            </p>
          </div>
          <a
            href="https://meezaan.dev"
            target="_blank"
            rel="noopener noreferrer"
            class="group mt-8 inline-flex items-center gap-2 text-xs font-medium uppercase tracking-[0.16em] text-background"
          >
            <span>More about me</span>
            <svg
              class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-1"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M7 17 17 7M7 7h10v10"
              />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section
    id="pricing"
    class="animate-section scroll-mt-28 bg-[#f3f3f3] py-20 md:py-28"
    aria-labelledby="pricing-heading"
  >
    <div class="container-site">
      <p
        class="text-center text-xs font-medium uppercase tracking-[0.2em] text-foreground/50"
      >
        Pricing
      </p>
      <h2
        id="pricing-heading"
        class="mx-auto mt-4 max-w-3xl text-center text-5xl leading-tight text-foreground md:text-6xl"
      >
        Okay, but how much?
      </h2>

      <div class="mt-14 grid gap-5 md:grid-cols-2 md:gap-6">
        {
          prices.map((item) => (
            <article class="hover-lift rounded-[28px] bg-background px-8 py-10 md:px-12 md:py-12">
              <p class="font-display text-3xl font-semibold leading-tight text-foreground">
                {item.service}
              </p>
              <p class="mt-6 text-base font-medium text-foreground/60">
                {item.price}
              </p>
            </article>
          ))
        }
      </div>

      <p class="mx-auto mt-8 max-w-2xl text-center text-sm leading-7 text-foreground/60">
        I'll give you a proper price before I start anything. No surprise
        invoices.
      </p>
    </div>
  </section>

  <section
    class="container-site animate-section pb-24 md:pb-32"
    aria-labelledby="cta-heading"
  >
    <div
      class="overflow-hidden rounded-[28px] bg-foreground px-6 py-14 text-background md:px-12 md:py-20"
    >
      <p class="text-xs font-medium uppercase tracking-[0.2em] text-background/50">
        Let's talk
      </p>
      <h2 id="cta-heading" class="mt-5 max-w-3xl text-5xl leading-tight md:text-7xl">
        Got something in mind?
      </h2>
      <p
        class="mt-6 max-w-2xl text-base leading-7 text-background/70 md:text-lg md:leading-8"
      >
        You don't need a brief or any technical knowledge. Just tell me about
        your business.
      </p>
      <a
        href="mailto:meezaandavids365@gmail.com"
        class="hover-lift mt-8 inline-flex rounded-full border border-background/30 px-6 py-4 font-display text-sm font-semibold text-background transition-colors hover:border-background/60"
      >
        Email instead
      </a>
    </div>
  </section>

  <a
    href={whatsappHref}
    target="_blank"
    rel="noopener noreferrer"
    class="hover-lift fixed bottom-5 right-5 z-50 flex h-16 w-16 items-center justify-center rounded-full bg-[#25d366] text-background ring-4 ring-background transition-transform sm:bottom-7 sm:right-7"
    aria-label="Chat to Meezaan on WhatsApp"
  >
    <svg class="h-9 w-9" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path
        d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.472-.148-.67.15-.198.296-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.999-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.886 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413"
      />
    </svg>
  </a>
</Layout>

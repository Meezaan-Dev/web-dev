---
import Layout from "../../layouts/Layout.astro";
import { websites } from "../../data/websites";

export function getStaticPaths() {
  return websites.map((website) => ({
    params: { slug: website.slug },
    props: { website },
  }));
}

const { website } = Astro.props;
---

<Layout
  title={`${website.title} | Web Dev.`}
  description={`${website.title} project by Meezaan Davids.`}
>
  <section class="container-site pb-20 pt-32 md:pb-28 md:pt-44">
    <a
      href="/#work"
      class="inline-flex text-xs font-medium uppercase tracking-[0.16em] text-foreground/50 transition-colors hover:text-foreground"
    >
      Back to work
    </a>

    <div class="mt-10 grid gap-8 md:grid-cols-[0.9fr_2.1fr] md:gap-16">
      <p class="text-xs font-medium uppercase tracking-[0.2em] text-foreground/50">
        {website.category} · {website.year}
      </p>
      <div>
        <h1 class="max-w-4xl text-5xl leading-[0.95] text-foreground md:text-7xl">
          {website.title}
        </h1>
        <p class="mt-8 max-w-2xl text-base leading-7 text-foreground/65 md:text-xl md:leading-9">
          {website.business}
        </p>
      </div>
    </div>
  </section>

  <section class="container-site pb-20 md:pb-28">
    <div class="overflow-hidden rounded-[28px] bg-foreground/[0.04] px-2 py-5 md:px-8 md:py-10">
      <img
        src={website.preview}
        alt={`${website.title} homepage preview`}
        class="mx-auto h-auto w-full"
      />
    </div>
  </section>

  <section class="container-site pb-24 md:pb-32">
    <div class="grid gap-10 border-t border-foreground/20 pt-10 md:grid-cols-[0.9fr_2.1fr] md:gap-16">
      <p class="text-xs font-medium uppercase tracking-[0.2em] text-foreground/50">
        Project
      </p>
      <div class="grid gap-8 md:grid-cols-3">
        <article>
          <h2 class="text-2xl text-foreground">Business</h2>
          <p class="mt-4 text-sm leading-7 text-foreground/60">
            {website.business}
          </p>
        </article>
        <article>
          <h2 class="text-2xl text-foreground">What they needed</h2>
          <p class="mt-4 text-sm leading-7 text-foreground/60">
            {website.need}
          </p>
        </article>
        <article>
          <h2 class="text-2xl text-foreground">What I built</h2>
          <p class="mt-4 text-sm leading-7 text-foreground/60">
            {website.built}
          </p>
        </article>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-4 sm:flex-row">
      <a
        href={website.url}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex justify-center rounded-full bg-foreground px-6 py-4 font-display text-sm font-semibold text-background transition-colors hover:bg-foreground/90"
      >
        Visit live website
      </a>
      <a
        href="/#work"
        class="inline-flex justify-center rounded-full border border-foreground/20 px-6 py-4 font-display text-sm font-semibold text-foreground transition-colors hover:border-foreground/40"
      >
        Back to projects
      </a>
    </div>
  </section>
</Layout>
